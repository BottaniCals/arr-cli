#!/bin/sh
# scripts/secret-scan -- grep the working tree for committed API keys (task 14.2).
#
# Implements the security NFR: "The repo SHALL contain no real secrets:
# a `scripts/secret-scan` (or pre-commit equivalent) SHALL grep for
# common API-key token shapes and SHALL fail the build if any are
# found committed."
#
# The scanner walks the project tree, applies the documented ignore list,
# and greps each text-like file for four patterns that cover the common
# accidental-commit shapes:
#
#   1. X-Api-Key: <value>      -- a real value pasted into a header
#   2. api_key    = "value"    -- a real value in a config-like file
#   3. apikey     = "value"    -- alternate spelling
#   4. token      = "value"    -- bearer-style token
#
# Each pattern requires the value to look like a real secret: at least
# 16 (api_key/apikey) or 20 (token) alphanumerics, which the documented
# placeholders (`YOUR_API_KEY_HERE`, `<user-id>`, `https://example.com`)
# do NOT match.
#
# Always-ignored paths (so the scanner does not flag itself or its
# fixtures):
#
#   .git/                -- version control metadata
#   venv/  .venv/  env/  -- virtualenvs
#   __pycache__/         -- Python bytecode
#   *.egg-info/          -- packaging metadata
#   dist/  build/        -- build outputs
#   .pytest_cache/       -- pytest cache
#   arr.conf.example     -- placeholder-only committed example
#   tests/               -- fixture files (may include mock secrets)
#   scripts/             -- the scanner itself + the smoke script
#                           (the smoke script contains the patterns
#                           as literals for documentation purposes)
#
# Exit codes
# ----------
#   0  no matches found
#   1  at least one match was found
#   2  internal error (no project root, etc.)
#
# POSIX sh portability
# --------------------
# Same constraints as smoke.sh: no bash-isms. `set -eu` only. Uses
# `find -prune` for directory exclusions (POSIX-portable). Uses `grep
# -E` for extended regex (POSIX). NO `[[`, NO arrays, NO `pipefail`.

set -eu

# Resolve project root from this script's location.
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
PROJECT_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
cd "$PROJECT_ROOT"

# --- pattern definitions ----------------------------------------------------
# The patterns match the documented NFR shapes. Each captures a long
# alnum string that the documented placeholders do not contain.
# We deliberately keep the regexes simple and POSIX-portable.

# X-Api-Key: <value>  -- header line with a real-looking value
#                      value must be 16+ alnum/dash/underscore
PAT_HEADER='X-Api-Key:[[:space:]]+[A-Za-z0-9_-]{16,}'

# api_key  = "value"    -- config-like assignment, 16+ alnum/dash/underscore
PAT_APIKEY_EQ='api_?key[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9_-]{16,}'

# token    = "value"    -- bearer-style assignment, 20+ alnum/dash/underscore
PAT_TOKEN_EQ='token[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9_-]{20,}'

# --- ignore-list ------------------------------------------------------------
# A list of literal substrings; a path matching ANY of these is skipped.
# Order does not matter; longer / more specific prefixes come first.
IGNORE_DIRS='
.git
.venv
venv
env
ENV
__pycache__
.pytest_cache
.mypy_cache
.ruff_cache
.tox
.eggs
dist
build
tests
scripts
node_modules
'

# Files always ignored (basename match).
IGNORE_FILES='
arr.conf.example
.gitignore
.secret-scan-allowlist
'

is_ignored_path() {
    # $1: path relative to project root
    _p=$1

    # Directory-name match: if any segment of the path equals an
    # ignored directory, the file is ignored.
    for d in $IGNORE_DIRS; do
        case ":$_p:" in
            *":/$d:"*|*"/$d/"*|*":$d:"*|*"/$d")
                return 0
                ;;
        esac
    done

    # Filename match.
    _base=$(basename "$_p")
    for f in $IGNORE_FILES; do
        if [ "$_base" = "$f" ]; then
            return 0
        fi
    done

    return 1
}

# --- main scan --------------------------------------------------------------
log() {
    printf 'secret-scan: %s\n' "$*"
}

fail() {
    printf 'secret-scan: FAIL: %s\n' "$*" >&2
    exit 2
}

# Build the candidate file list with `find`. `-prune` keeps us out of
# ignored directories entirely so we never even stat their files.
log "scanning $PROJECT_ROOT for committed secrets..."

# Compose the find expression. Each `-path <dir> -prune -o` excludes a
# directory. We use `-print` at the end to emit surviving paths.
FIND_EXPR='.'
for d in $IGNORE_DIRS; do
    FIND_EXPR="$FIND_EXPR -path ./$d -prune -o -path */$d -prune -o"
done
# `-type f` selects regular files only (no symlinks, no sockets, no
# devices). `-print` emits each surviving path on its own line.

# shellcheck disable=SC2086
CANDIDATES=$(find $FIND_EXPR -type f -print 2>/dev/null \
    | grep -v -E '/(\.git|\.venv|venv|env|ENV|__pycache__|\.pytest_cache|\.mypy_cache|\.ruff_cache|\.tox|\.eggs|dist|build|tests|scripts|node_modules)/' \
    || true)

MATCH_COUNT=0

for path in $CANDIDATES; do
    # Strip the leading ./ that find emits; the relative path is more
    # readable in error output and matches the project's git paths.
    case "$path" in
        ./*) rel=${path#./} ;;
        *)   rel=$path ;;
    esac

    # Double-check the ignore list here too so any path that slipped
    # through find's prune logic (e.g. symlinked directories) is still
    # suppressed.
    if is_ignored_path "$rel"; then
        continue
    fi

    # Grep each pattern. `-E` for ERE (POSIX-portable). `-H` prints the
    # filename. `--` terminates the option list so a path beginning
    # with `-` does not get interpreted as a flag. We send each
    # pattern into a separate grep so the error report can name which
    # shape was matched.
    if grep -EH -e "$PAT_HEADER"    -- "$rel" >/dev/null 2>&1; then
        printf 'secret-scan: MATCH in %s (X-Api-Key: <value> pattern)\n' "$rel" >&2
        MATCH_COUNT=$((MATCH_COUNT + 1))
    fi
    if grep -EH -e "$PAT_APIKEY_EQ" -- "$rel" >/dev/null 2>&1; then
        printf 'secret-scan: MATCH in %s (api_key = pattern)\n' "$rel" >&2
        MATCH_COUNT=$((MATCH_COUNT + 1))
    fi
    if grep -EH -e "$PAT_TOKEN_EQ"  -- "$rel" >/dev/null 2>&1; then
        printf 'secret-scan: MATCH in %s (token = pattern)\n' "$rel" >&2
        MATCH_COUNT=$((MATCH_COUNT + 1))
    fi
done

if [ "$MATCH_COUNT" -gt 0 ]; then
    printf 'secret-scan: %d potential secret(s) found; refusing to pass the build.\n' "$MATCH_COUNT" >&2
    printf '             Move the offending value out of the repo, rotate the key, and re-run.\n' >&2
    exit 1
fi

log 'no committed secrets detected'
exit 0